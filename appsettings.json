{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "SkillRadar": {
    "GitHub": {
      "Topics": [ "claude-skills", "claude-code-skills", "agent-skills" ],
      "SeedRepos": [ "anthropics/skills" ],
      "MinStars": 5,
      "MaxReposPerTopic": 50,
      "ApiBaseUrl": "https://api.github.com"
    },
    "Persistence": {
      "DatabasePath": "state/skills.db"
    },
    "Scoring": {
      "Heat": {
        "StarWeight": 4.0,
        "FreshnessWeight": 3.0,
        "FreshnessHalfLifeDays": 30.0,
        "DensityWeight": 1.0
      },
      "LlmRelevance": {
        "Enabled": false,
        "Model": "claude-haiku-4-5",
        "MaxItemsToScore": 30
      }
    },
    "Reporting": {
      "TopN": 20,
      "OutputDirectory": "reports"
    }
  }
}
